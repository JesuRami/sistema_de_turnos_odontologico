# Contrato de configuración (valores de EJEMPLO no secretos — nunca commitear .env).
# Verificado por backend/tests/test_env_example.py (claves requeridas de Settings ⊆ este archivo).

ENV=dev
DATABASE_URL=postgresql+asyncpg://turnos:changeme@localhost:5432/turnos
REDIS_URL=redis://localhost:6379/0

# ≥32 bytes (openssl rand -hex 32); el arranque falla si es más corto.
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ISSUER=turnos-odontologico
JWT_AUDIENCE=turnos-odontologico-api
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Sesiones de auth en una base lógica propia de Redis (no secreto).
REDIS_AUTH_DB=15
# Rate-limit de autenticación: "<intentos>/<segundos>s" (no secretos).
AUTH_LOGIN_RATE_LIMIT=5/60s
AUTH_LOGIN_IP_RATE_LIMIT=30/60s
AUTH_REFRESH_RATE_LIMIT=60/60s
AUTH_PASSWORD_RATE_LIMIT=5/60s
# En prod dejar vacío: con `__Host-` la cookie no lleva Domain.
COOKIE_DOMAIN=

BOOKING_RATE_LIMIT=30/minute
MANAGE_TOKEN_TTL_H=72
# Gestión por token (C-08): cupos en Redis "<intentos>/<segundos>s". El de token usa el
# SHA-256 del token como clave; Redis nunca ve el token en claro.
MANAGE_READ_IP_RATE_LIMIT=120/60s
MANAGE_READ_TOKEN_RATE_LIMIT=60/60s
MANAGE_WRITE_IP_RATE_LIMIT=30/60s
MANAGE_WRITE_TOKEN_RATE_LIMIT=10/60s
# Reserva pública (C-07): cupos en Redis "<intentos>/<segundos>s", horizonte de reserva en
# días, versión de la política de privacidad aceptada y verificador anti-bot (noop = v1).
PUBLIC_BOOKING_IP_RATE_LIMIT=10/3600s
PUBLIC_BOOKING_SLUG_RATE_LIMIT=300/3600s
PUBLIC_BOOKING_READ_RATE_LIMIT=120/60s
PUBLIC_BOOKING_HORIZON_DAYS=60
PRIVACY_POLICY_VERSION=2026-11-placeholder
BOT_GUARD=noop
FRONTEND_PUBLIC_URL=http://localhost:5173
# Lista separada por comas: 5173 = frontend prod (nginx), 5174 = Vite dev (compose.override.yaml).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CLINIC_TZ_DEFAULT=America/Argentina/Buenos_Aires

WHATSAPP_TOKEN=example-meta-cloud-api-token
META_APP_ID=example-app-id
META_APP_SECRET=example-app-secret
META_PHONE_NUMBER_ID=example-phone-number-id
META_API_VERSION=v19.0
META_VERIFY_TOKEN=example-webhook-verify-token

EMAIL_HOST=example-smtp-host
EMAIL_PORT=587
EMAIL_USER=example-smtp-user
EMAIL_PASSWORD=example-smtp-password
EMAIL_FROM=turnos@example.com

REMINDER_WORKER_CONCURRENCY=10

# Seed del tenant inicial (python -m app.seed, C-02). Solo datos sintéticos.
SEED_CLINIC_SLUG=clinica-demo
SEED_CLINIC_NAME=Clínica Demo Ficticia
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=cambiar-esta-clave-provisoria
