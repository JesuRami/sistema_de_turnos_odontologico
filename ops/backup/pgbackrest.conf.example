# Ejemplo — completar en el host. La passphrase sale del entorno/secret manager, no de este archivo.
[global]
repo1-path=/var/lib/pgbackrest
repo1-cipher-type=aes-256-cbc
# repo1-cipher-pass=  <- definir vía PGBACKREST_REPO1_CIPHER_PASS
repo1-retention-full=4
start-fast=y

[turnos]
pg1-path=/var/lib/postgresql/data
pg1-user=turnos
